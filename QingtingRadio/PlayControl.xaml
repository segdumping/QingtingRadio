<UserControl
    x:Class="QingtingRadio.PlayControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QingtingRadio"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="48"/>
        </Grid.ColumnDefinitions>
        <Ellipse Name="PreviousEllipse" Grid.Column="0" Width="24" Height="24" Fill="{ThemeResource SystemAccentColor}" Opacity="0.9"></Ellipse>
        <Button Name="Previous"
                Grid.Column="0" 
                Width="32" 
                Height="32"
                Content="&#xE100;" 
                FontFamily="Segoe MDL2 Assets" 
                FontSize="14"
                Click="{x:Bind MediaList.SkipPrevious}"
                Background="Transparent"
                Style="{StaticResource CustomButtonStyle}">
        </Button>
        <Ellipse Grid.Column="1" Width="36" Height="36" Fill="{ThemeResource SystemAccentColor}" Opacity="0.9"></Ellipse>
        <Button Name="Play"
                Grid.Column="1" 
                Width="36" 
                Height="36"
                Content="&#xE102;" 
                FontFamily="Segoe MDL2 Assets" 
                FontSize="16"
                Click="PlayButton_Click" 
                Background="Transparent"
                Style="{StaticResource CustomButtonStyle}">
        </Button>
        <ProgressRing Name="BufferRing"
                      Grid.Column="1"
                      TabIndex="100"                    
                      Height="36"
                      Foreground="Blue"
                      Width="36">
        </ProgressRing>
        <Ellipse Name="NextEllipse" Grid.Column="2" Width="24" Height="24" Fill="{ThemeResource SystemAccentColor}" Opacity="0.9"></Ellipse>
        <Button Name="Next"
                Grid.Column="2" 
                Width="32" 
                Height="32"
                Content="&#xE101;" 
                FontFamily="Segoe MDL2 Assets" 
                FontSize="14"
                Click="{x:Bind MediaList.SkipNext}"
                Background="Transparent"
                Style="{StaticResource CustomButtonStyle}">
        </Button>
    </Grid>
</UserControl>
