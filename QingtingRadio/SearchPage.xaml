<Page
    x:Class="QingtingRadio.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QingtingRadio"
    xmlns:pr="using:PullToRefresh.UWP"
    xmlns:data="using:QingtingRadio.DataModels"
    xmlns:controls="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:vm="using:QingtingRadio.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:text="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    mc:Ignorable="d"
    x:Name="Page"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <Page.Resources>
        <local:ConvertSearchCommonData x:Key="convertSearchCommonData"></local:ConvertSearchCommonData>
        <local:SearchItemDataTemplateSelector x:Key="searchItemDataTemplateSelector"
                                              SearchRadioTemplate="{StaticResource SearchRadioTemplate}"
                                              SearchProgramTemplate="{StaticResource SearchProgramTemplate}"
                                              SearchAlbumTemplate="{StaticResource SearchAlbumTemplate}">
        </local:SearchItemDataTemplateSelector>

        <local:SearchFavoriteCommand x:Key="searchFavoriteCommand" />
        <local:SearchItemDownloadCommand x:Key="searchItemDownloadCommand" />
        
        <DataTemplate x:Key="SearchRadioTemplate" x:DataType="data:SearchItemRadio">
            <controls:SlidableListItem                         
                    DataContext="{Binding ElementName=Page, Path=DataContext, Mode=OneWay}"
                    HorizontalAlignment="Stretch"
                    ActivationWidth="64"                            
                    IsLeftCommandEnabled="True"
                    IsOffsetLimited="True"                             
                    IsPointerReleasedOnSwipingHandled="True"
                    IsRightCommandEnabled="False"
                    LeftBackground="SkyBlue"          
                    LeftForeground ="White"
                    LeftCommand="{StaticResource searchFavoriteCommand}"
                    LeftCommandParameter="{Binding DataContext, RelativeSource={RelativeSource TemplatedParent}}"
                    LeftIcon="Favorite"
                    LeftLabel="收藏"
                    MouseSlidingEnabled="False">
                <Grid Margin="0" 
                      Background="Transparent"
                      PointerEntered="Radio_PointerEntered"
                      PointerExited="Radio_PointerExited"
                      Width="{Binding ElementName=width,Path=Width}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="RadioThumb" 
                            Width ="64"
                            Height="64"
                            Grid.Column="0"            
                            Opacity="{Binding ElementName=width, Path=Opacity}"
                            HorizontalAlignment="Center">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding DataContext.ImageUri ,RelativeSource={RelativeSource TemplatedParent} ,TargetNullValue=ms-appx:///Assets/recommend_defaultbg.png, FallbackValue=ms-appx:///Assets/recommend_defaultbg.png}"></ImageBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse x:Name="TransportMark" 
                            Width ="68"
                            Height="68"
                            Grid.Column="0"
                            HorizontalAlignment="Center">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="ms-appx:///Assets/radio_transport_background.png"></ImageBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="12,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Vertical" Grid.Column="0">
                                <TextBlock Text="{x:Bind Title}" FontSize="13" TextWrapping="NoWrap" TextAlignment="Left" />
                                <TextBlock Text="{x:Bind Freqs}" FontSize="12" Margin="0,5,0,0" Foreground="#FF61A3AE" TextWrapping="NoWrap" TextAlignment="Left" />
                            </StackPanel>
                            <Button Content="&#xE1CE;" FontFamily="Segoe MDL2 Assets" Click="FavoriteAlbum_Click" VerticalAlignment="Top" Background="Transparent" Grid.Column="1" Visibility="Collapsed" DataContext="{Binding DataContext, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="听众：" Foreground="#FF94C5CD" FontSize="12" Margin="0,5,0,0"/>
                            <TextBlock Text="{x:Bind PlayCount}" Foreground="#FF94C5CD" Margin="0,5,0,0"  FontSize="12" TextWrapping="NoWrap" TextAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </controls:SlidableListItem>
        </DataTemplate>
        <DataTemplate x:Key="SearchProgramTemplate" x:DataType="data:SearchItemProgram">
            <controls:SlidableListItem                         
                    DataContext="{Binding ElementName=Page, Path=DataContext, Mode=OneWay}"
                    HorizontalAlignment="Stretch"
                    ActivationWidth="64"                            
                    IsLeftCommandEnabled="True"
                    IsOffsetLimited="True"                             
                    IsPointerReleasedOnSwipingHandled="True"
                    LeftBackground="SkyBlue"          
                    LeftForeground ="White"
                    LeftCommand="{StaticResource searchFavoriteCommand}"
                    LeftCommandParameter="{Binding DataContext, RelativeSource={RelativeSource TemplatedParent}}"
                    LeftIcon="Favorite"
                    LeftLabel="收藏"    
                    IsRightCommandEnabled="True"
                    RightBackground="SpringGreen"
                    RightForeground="White"
                    RightIcon="Download"
                    RightLabel="下载"
                    RightCommand="{StaticResource searchItemDownloadCommand}"
                    RightCommandParameter="{Binding DataContext, RelativeSource={RelativeSource TemplatedParent}}"
                    MouseSlidingEnabled="False">
                <Grid Margin="0" 
                      Background="Transparent"
                      PointerEntered="Program_PointerEntered"
                      PointerExited="Program_PointerExited"
                      Width="{Binding ElementName=width,Path=Width}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="ProgramThumb" 
                            Width ="64"
                            Height="64"
                            Opacity="{Binding ElementName=width, Path=Opacity}"
                            Grid.Column="0"                                     
                            HorizontalAlignment="Center">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding DataContext.ImageUri ,RelativeSource={RelativeSource TemplatedParent} ,TargetNullValue=ms-appx:///Assets/recommend_defaultbg.png, FallbackValue=ms-appx:///Assets/recommend_defaultbg.png}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse x:Name="WaterMark" 
                        Width ="68"
                        Height="68"
                        Grid.Column="0"     
                        Opacity="{Binding ElementName=width, Path=Opacity}"
                        HorizontalAlignment="Center">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="ms-appx:///Assets/ic_notification_pause_white.png"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Grid Grid.Column="1" Margin="12,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Vertical" Grid.Column="0">
                                <TextBlock Text="{x:Bind Title}" Grid.Row="0"  FontSize="13" TextWrapping="NoWrap" TextTrimming="WordEllipsis"/>
                                <TextBlock Text="{x:Bind AlbumName}" Grid.Row="1" Margin="0,5,0,0" FontSize="12" Foreground="#FF61A3AE" TextWrapping="NoWrap" TextTrimming="WordEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Top">
                                <Button Content="&#xE1CE;" FontFamily="Segoe MDL2 Assets" Background="Transparent"  Click="FavoriteAlbum_Click" DataContext="{Binding DataContext, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Button Content="&#xE118;" FontFamily="Segoe MDL2 Assets" Background="Transparent" Click="DownloadAlbum_Click" DataContext="{Binding DataContext, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </StackPanel>
                        </Grid>
                        <RelativePanel Grid.Row="1" >
                            <StackPanel Orientation="Horizontal" RelativePanel.AlignLeftWithPanel="True">
                                <TextBlock Text="播放：" Foreground="#FF94C5CD" FontSize="12" Margin="0,5,0,0"/>
                                <TextBlock Text="{x:Bind PlayCount}" Margin="0,5,0,0" Foreground="#FF94C5CD" FontSize="12" TextWrapping="NoWrap" TextAlignment="Left" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind Duration,Converter={StaticResource convertSearchCommonData},ConverterParameter=duration}" RelativePanel.AlignHorizontalCenterWithPanel="True" Margin="4,5,0,0" Foreground="#FF94C5CD" FontSize="12" TextWrapping="NoWrap" TextAlignment="Left" />
                            <TextBlock Text="{x:Bind UpdateTime,Converter={StaticResource convertSearchCommonData},ConverterParameter=updatetime}" Margin="4,5,0,0" RelativePanel.AlignRightWithPanel="True" Foreground="#FF94C5CD" FontSize="12" TextWrapping="NoWrap" TextAlignment="Left" />
                        </RelativePanel>
                    </Grid>
                </Grid>
            </controls:SlidableListItem>
        </DataTemplate>
        <DataTemplate x:Key="SearchAlbumTemplate" x:DataType="data:SearchItemAlbum">
            <controls:SlidableListItem                         
                    DataContext="{Binding ElementName=Page, Path=DataContext, Mode=OneWay}"
                    HorizontalAlignment="Stretch"
                    ActivationWidth="64"                            
                    IsLeftCommandEnabled="True"
                    IsOffsetLimited="True"                             
                    IsPointerReleasedOnSwipingHandled="True"
                    IsRightCommandEnabled="False"
                    LeftBackground="SkyBlue"          
                    LeftForeground ="White"
                    LeftCommand="{StaticResource searchFavoriteCommand}"
                    LeftCommandParameter="{Binding DataContext, RelativeSource={RelativeSource TemplatedParent}}"
                    LeftIcon="Favorite"
                    LeftLabel="收藏"                             
                    MouseSlidingEnabled="False">
                <Grid Margin="0" 
                      Background="Transparent"
                      PointerEntered="Album_PointerEntered"
                      PointerExited="Album_PointerExited"
                      Width="{Binding ElementName=width,Path=Width}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Width="64" HorizontalAlignment="Center" VerticalAlignment="Center"  Grid.Column="0" Opacity="{Binding ElementName=width, Path=Opacity}"
                           Source="{Binding DataContext.ImageUri ,RelativeSource={RelativeSource TemplatedParent} ,TargetNullValue=ms-appx:///Assets/recommend_defaultbg.png, FallbackValue=ms-appx:///Assets/recommend_defaultbg.png}">
                    </Image>
                    <Grid Grid.Column="1" Margin="12,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Vertical" Grid.Column="0">
                                <TextBlock Text="{x:Bind Title}" Grid.Row="0" FontSize="13" TextWrapping="NoWrap" TextTrimming="WordEllipsis"/>
                                <TextBlock Text="{x:Bind Description}" TextTrimming="WordEllipsis" MaxLines="1" Grid.Row="1" Margin="0,5,0,0" FontSize="12" Foreground="#FF61A3AE" TextWrapping="NoWrap"/>
                            </StackPanel>
                            <Button Content="&#xE1CE;" FontFamily="Segoe MDL2 Assets" Click="FavoriteAlbum_Click" VerticalAlignment="Top" Background="Transparent" Grid.Column="1" Visibility="Collapsed" DataContext="{Binding DataContext, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Grid>
                        <RelativePanel Grid.Row="1">
                            <StackPanel Orientation="Horizontal"  RelativePanel.AlignLeftWithPanel="True">
                                <TextBlock Text="播放：" Foreground="#FF94C5CD" FontSize="12"  Margin="0,5,0,0"/>
                                <TextBlock Text="{x:Bind PlayCount}" Margin="0,5,0,0" Foreground="#FF94C5CD" FontSize="12" TextWrapping="NoWrap" TextAlignment="Left" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind UpdateTime,Converter={StaticResource convertSearchCommonData},ConverterParameter=updatetime}" RelativePanel.AlignRightWithPanel="True" Margin="4,5,8,0" Foreground="#FF94C5CD" FontSize="12" TextWrapping="NoWrap" TextAlignment="Left" />
                        </RelativePanel>
                    </Grid>
                </Grid>
            </controls:SlidableListItem>
        </DataTemplate>
    </Page.Resources>
    
    <Grid SizeChanged="Grid_SizeChanged"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <local:PageHeader VerticalAlignment="Center">
            <local:PageHeader.HeaderContent>
                <TextBlock Name="TitleName" Text="搜索" VerticalAlignment="Center" Margin="0,0,0,2" FontSize="16"/>
            </local:PageHeader.HeaderContent>
        </local:PageHeader>
        <Grid Grid.Row="1" Height="48">
            <ComboBox Name="SearchType"
                      BorderThickness="0"
                      Margin="8,0,0,0"
                      VerticalAlignment="Center"
                      SelectionChanged="SearchType_SelectionChanged"
                      PlaceholderText="全部">
                <ComboBoxItem Content="全部" Tag="0"/>
                <ComboBoxItem Content="电台" Tag="1"/>
                <ComboBoxItem Content="节目" Tag="2"/>
                <ComboBoxItem Content="专辑" Tag="3"/>
            </ComboBox>
            <AutoSuggestBox Name="SearchBox"                                  
                            QueryIcon="Find"
                            TextChanged="SearchBox_TextChanged"
                            Background="Transparent"
                            PlaceholderText="电台、节目、专辑"
                            QuerySubmitted="SearchBox_QuerySubmitted"
                            VerticalAlignment="Center"
                            Margin="96,0,16,0">
            </AutoSuggestBox>
        </Grid>
        <Border x:Name="width" Visibility="Collapsed" Grid.Row="2"/>
        <pr:PullToRefreshBox Grid.Row="2" RefreshThreshold="48" RefreshInvoked="PullToRefreshBox_RefreshInvoked">
            <ListView Name="SearchResults"
                  CanDragItems="False"
                  Grid.Row="2"                  
                  Visibility="Collapsed"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemTemplateSelector="{StaticResource searchItemDataTemplateSelector}"
                  Style="{StaticResource RadioItemListStyle}"
                  ItemContainerStyle="{StaticResource CardItemStyle}"
                  ItemClick="SearchResults_ItemClick">
            </ListView>
        </pr:PullToRefreshBox>
        <Grid Name="SearchHistory" Grid.Row="2">
            <Grid Name="HistorySearchWords">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <RelativePanel Grid.Row="0" MinHeight="24" >
                    <TextBlock Text="搜索历史" RelativePanel.AlignLeftWithPanel="True" RelativePanel.AlignVerticalCenterWithPanel="True" Margin="12,0,0,0" Foreground="{ThemeResource SystemAccentColor}"/>
                    <Button Name="ClearSearchHistory" Content="清空" Click="ClearSearchHistory_Click" RelativePanel.AlignRightWithPanel="True" Style="{StaticResource CustomButtonStyle}" RelativePanel.AlignBottomWithPanel="True" Margin="0,0,8,0"></Button>
                </RelativePanel>
                <ListView Name="HistoryWords"
                          Grid.Row="1"
                          CanReorderItems="False"
                          CanDragItems="False"              
                          IsItemClickEnabled="True"
                          SelectionMode="None"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                          ItemClick="HistoryWords_ItemClick"
                          Style="{StaticResource RadioItemListStyle}"
                          ItemsSource="{Binding _searchHistory}">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{text:Binding}" TextTrimming="WordEllipsis" Grid.Column="0"/>
                                <Button Name="DeleteWord"
                                        Content="&#xE10A;" 
                                        FontFamily="Segoe MDL2 Assets" 
                                        FontSize="12"         
                                        Margin="4,0,0,0"
                                        Grid.Column="1"
                                        Click="DeleteWord_Click"
                                        RelativePanel.AlignRightWithPanel="True"
                                        Style="{StaticResource CustomButtonStyle}">
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
        <ProgressRing Name="RingCircle" TabIndex="100" Height="60" Width="60" Grid.RowSpan="3"
                      Foreground="{ThemeResource SystemAccentColor}">
        </ProgressRing>
    </Grid>
</Page>
