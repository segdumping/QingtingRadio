<Page
    x:Class="QingtingRadio.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QingtingRadio"
    xmlns:data="using:QingtingRadio.DataModels"
    xmlns:controls="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">
  
    <Grid SizeChanged="Grid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <local:PageHeader VerticalAlignment="Center">
            <local:PageHeader.HeaderContent>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Name="TitleName" Text="历史" VerticalAlignment="Center" Margin="0,0,0,2" FontSize="16"/>
                    <Button Name="DeleteAll"
                                Content="&#xE107;" 
                                FontFamily="Segoe MDL2 Assets"  
                                FontSize="16" 
                                Margin="0,0,0,2" 
                                Grid.Column="2"
                                Background="Transparent"
                                Click="DeleteAll_Click"
                                Style="{StaticResource CustomButtonStyle}">
                    </Button>
                </Grid>
            </local:PageHeader.HeaderContent>
        </local:PageHeader>
        <Border x:Name="width" Visibility="Collapsed"/>
        <ListView Name="HistoryRadiosView"                  
                  CanReorderItems="False"
                  CanDragItems="False"                  
                  IsItemClickEnabled="True"
                  SelectionMode="None"
                  ItemsSource="{Binding}"
                  Grid.Row="1"
                  Style="{StaticResource RadioItemListStyle}"
                  ItemContainerStyle="{StaticResource CardItemStyle}"
                  ItemClick="HistoryRadiosView_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="data:LastestPlay">
                    <Grid Width="{Binding ElementName=width,Path=Width}" Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" 
                                    HorizontalAlignment="Center" 
                                    VerticalAlignment="Center">
                            <Image  x:Name="RadioImage" 
                                    HorizontalAlignment="Right" 
                                    VerticalAlignment="Center" 
                                    Width="64"
                                    Opacity="{Binding ElementName=width, Path=Opacity}"
                                   Source="{Binding ImageUri,TargetNullValue=Assets\recommend_defaultbg.png, FallbackValue=Assets\recommend_defaultbg.png}">
                            </Image>
                        </StackPanel>
                        <RelativePanel Grid.Column="1"
                                       Margin="16,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <RelativePanel Grid.Row="0" 
                                               Margin="0,1">
                                    <TextBlock Text="{x:Bind Title}" 
                                               VerticalAlignment="Center" 
                                               TextTrimming="WordEllipsis"
                                               FontSize="13" 
                                               Margin="0">
                                    </TextBlock>
                                </RelativePanel>
                                <RelativePanel Grid.Row="1" 
                                               Margin="0,1">
                                    <TextBlock Text="{x:Bind Playing,  TargetNullValue=暂无节目单}" 
                                               VerticalAlignment="Center" 
                                               TextTrimming="WordEllipsis"
                                               FontSize="13" 
                                               Margin="0" 
                                               Foreground="#FF61A3AE">
                                    </TextBlock>
                                </RelativePanel>
                                <RelativePanel Grid.Row="2" 
                                               Margin="0,1">
                                    <TextBlock Text="收听时间：" 
                                               VerticalAlignment="Center" 
                                               FontSize="13" 
                                               Margin="0" 
                                               Foreground="#FFDE8E8E"/>
                                    <TextBlock Text="{x:Bind StartTime, TargetNullValue=00:00-00:00}" 
                                               VerticalAlignment="Center" 
                                               FontSize="13" 
                                               Margin="64,0,0,0" 
                                               Foreground="#FFDE8E8E"/>
                                </RelativePanel>
                            </Grid>
                        </RelativePanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <ProgressRing Name="RingCircle" TabIndex="100" Height="60" Width="60" Grid.RowSpan="2"
                      Foreground="{ThemeResource SystemAccentColor}">
        </ProgressRing>
    </Grid>
</Page>
