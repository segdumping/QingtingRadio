<UserControl
    x:Class="QingtingRadio.VolumeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QingtingRadio"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="344"
    d:DesignWidth="1052">

    <Grid Name="volumeBar">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>
        <Button Name="VolumeValue"
                        Width="36" 
                        Height="36"  
                        Background="Transparent"
                        Content="&#xE767;" 
                        FontFamily="Segoe MDL2 Assets" 
                        FontSize="12" 
                        Margin="4,0"
                        Grid.Column="0"
                        Click="VolumeControl_Click"
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Left"
                        Style="{StaticResource CustomButtonStyle}">
        </Button>
        <Slider Name="volumeSlider"  
                        Value="{Binding Volume ,Mode=TwoWay}"
                        ValueChanged="VolumeSlider_ValueChanged"
                        Style="{StaticResource  CustomSliderStyle}"
                        StepFrequency="1" 
                        Minimum="0" 
                        SmallChange="1"                        
                        LargeChange="10"  
                        Grid.Column="1"
                        FontSize="12"
                        VerticalAlignment="Center" 
                        MinWidth="256" 
                        Margin="4,0">
        </Slider>
        <TextBlock Text="{Binding ElementName=volumeSlider, Path=Value}" 
                    Margin="4,0"
                    Grid.Column="2"
                    FontSize="12"
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Right">
        </TextBlock>
    </Grid>
</UserControl>
