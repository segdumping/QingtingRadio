<Page
    x:Class="QingtingRadio.RadioList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QingtingRadio"
    xmlns:data="using:QingtingRadio.DataModels"
    xmlns:vm="using:QingtingRadio.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource LargeWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Search.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MediumWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Search.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Search.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <local:PageHeader VerticalAlignment="Center">
            <local:PageHeader.HeaderContent>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Name="TitleName" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,2" FontSize="16"/>
                    <Button Name="Search"
                            Content="&#xE094;" 
                            FontFamily="Segoe MDL2 Assets"  
                            FontSize="16" 
                            Margin="0,0,20,2"
                            Grid.Column="2"
                            Background="Transparent"
                            Click="Search_Click"
                            Style="{StaticResource CustomButtonStyle}">
                    </Button>
                </Grid>
            </local:PageHeader.HeaderContent>
        </local:PageHeader>
        <local:RadioControl x:Name="RadioLists" Grid.Row="1"></local:RadioControl>
        <ProgressRing Name="RingCircle" TabIndex="100" Height="60" Width="60" Grid.RowSpan="2"
                      Foreground="{ThemeResource SystemAccentColor}">
        </ProgressRing>
    </Grid>
</Page>
