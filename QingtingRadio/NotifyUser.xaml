<UserControl
    x:Class="QingtingRadio.NotifyUser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QingtingRadio"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <UserControl.Resources>
        <Storyboard x:Name="sbOut" >
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="mainGrid"
                                           Storyboard.TargetProperty="Opacity">
                <SplineDoubleKeyFrame  KeyTime="00:00:00.00" Value="1"/>
                <SplineDoubleKeyFrame  KeyTime="00:00:00.400" Value="0.0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="mainGrid" >
        <Border Name="tip"
                Background="{ThemeResource SystemAccentColor}"
                Opacity="0.98"
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Top" 
                MinHeight="124">
            <TextBlock x:Name="tbNotify" 
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       FontSize="16"
                       Margin="0,0,0,36"
                       Foreground="White"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
