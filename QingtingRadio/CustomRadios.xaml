<Page
    x:Class="QingtingRadio.CustomRadios"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QingtingRadio"
    xmlns:data="using:QingtingRadio.DataModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource LargeWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AddRadio.Visibility" Value="Visible"/>
                        <Setter Target="CustomRadiosView.CanReorderItems" Value="true"/>
                        <Setter Target="CustomRadiosView.CanDragItems" Value="true"/>
                        <Setter Target="CustomRadiosView.AllowDrop" Value="true"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MediumWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AddRadio.Visibility" Value="Visible"/>
                        <Setter Target="CustomRadiosView.CanReorderItems" Value="true"/>
                        <Setter Target="CustomRadiosView.CanDragItems" Value="true"/>
                        <Setter Target="CustomRadiosView.AllowDrop" Value="true"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AddRadio.Visibility" Value="Visible"/>
                        <Setter Target="CustomRadiosView.CanReorderItems" Value="false"/>
                        <Setter Target="CustomRadiosView.CanDragItems" Value="false"/>
                        <Setter Target="CustomRadiosView.AllowDrop" Value="false"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <local:PageHeader VerticalAlignment="Center">
            <local:PageHeader.HeaderContent>
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Name="TitleName" VerticalAlignment="Center" Margin="0,0,0,2" FontSize="16"/>
                    <Button Name="ImportRadio"
                            Content="&#xE150;" 
                            FontFamily="Segoe MDL2 Assets"  
                            FontSize="16" 
                            Margin="0,0,8,2"
                            Grid.Column="2"
                            Background="Transparent"
                            Click="ImportRadio_Click"
                            ToolTipService.ToolTip="导入自定义电台"
                            Style="{StaticResource CustomButtonStyle}">
                    </Button>
                    <Button Name="ExportRadio"
                            Content="&#xEDE1;" 
                            FontFamily="Segoe MDL2 Assets"  
                            FontSize="16" 
                            Margin="0,0,8,2"
                            Grid.Column="3"
                            Background="Transparent"
                            Click="ExportRadio_Click"
                            ToolTipService.ToolTip="导出自定义电台"
                            Style="{StaticResource CustomButtonStyle}">
                    </Button>
                    <Button Name="AddRadio"
                            Content="&#xE109;" 
                            FontFamily="Segoe MDL2 Assets"  
                            FontSize="16" 
                            Margin="0,0,8,2"
                            Grid.Column="4"
                            Background="Transparent"
                            Click="AddRadio_Click"
                            ToolTipService.ToolTip="添加电台"
                            Style="{StaticResource CustomButtonStyle}">
                    </Button>
                </Grid>
            </local:PageHeader.HeaderContent>
        </local:PageHeader>
        <ListView Name="CustomRadiosView"
                  CanReorderItems="True"
                  CanDragItems="True"
                  AllowDrop="True"
                  IsItemClickEnabled="True"
                  SelectionMode="None"
                  Grid.Row="1"
                  ItemsSource="{x:Bind items}"
                  ItemClick="CustomRadiosView_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="data:CustomRadio">
                    <StackPanel Name="ContextMenu" 
                                RightTapped="ContextMenu_RightTapped" 
                                Holding="ContextMenu_Holding" 
                                Background="Transparent">
                        <FlyoutBase.AttachedFlyout>
                            <MenuFlyout x:Name="menuFlyout">
                                <MenuFlyout.Items>
                                    <MenuFlyoutItem Name="DeleteCustomRadio" 
                                        Text="删除" 
                                        Click="DeleteCustomRadio_Click">
                                    </MenuFlyoutItem>
                                </MenuFlyout.Items>
                            </MenuFlyout>
                        </FlyoutBase.AttachedFlyout>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Title}" Grid.Column="0" Margin="8,0,0,0"/>
                            <StackPanel Grid.Column="1" Background="Transparent">
                                <ScrollViewer HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden">
                                    <TextBlock Text="{x:Bind PlayUri}"  Margin="0,0,8,0"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <ProgressRing Name="RingCircle" TabIndex="100" Height="60" Width="60" Grid.RowSpan="2"
                      Foreground="{ThemeResource SystemAccentColor}">
        </ProgressRing>
    </Grid>
</Page>
