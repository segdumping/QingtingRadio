<UserControl
    x:Class="QingtingRadio.RadioControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QingtingRadio"
    xmlns:pr="using:PullToRefresh.UWP"
    xmlns:vm="using:QingtingRadio.ViewModels"
    xmlns:data="using:QingtingRadio.DataModels"
    xmlns:controls="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="Control"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <UserControl.Resources>
        <vm:ConvertAudienceCount x:Key="convertAudienceCount"></vm:ConvertAudienceCount>
        <vm:ConvertNowPlaying x:Key="convertNowPlaying"></vm:ConvertNowPlaying>
        <vm:ConverPlayDuration x:Key="converPlayDuration"></vm:ConverPlayDuration>
        <local:FavoriteItemCommand x:Key="FavoriteItemCommand" />
        <!-- 卡片外观：深浅主题下都用中性灰底+细边框，悬停切强调色 -->
        <SolidColorBrush x:Key="CardNormalBackground" Color="#0F808080"/>
        <SolidColorBrush x:Key="CardNormalBorderBrush" Color="#33808080"/>
        <SolidColorBrush x:Key="CardHoverBackground" Color="{StaticResource SystemAccentColor}" Opacity="0.12"/>
        <SolidColorBrush x:Key="CardHoverBorderBrush" Color="{StaticResource SystemAccentColor}" Opacity="0.7"/>
        <!-- 行容器去掉默认的悬停高亮/阴影圈，视觉反馈全部由卡片自身承担 -->
        <Style x:Key="PlainCardItemStyle" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border x:Name="width" Visibility="Collapsed"/>
        <pr:PullToRefreshBox RefreshThreshold="48" RefreshInvoked="PullToRefreshBox_RefreshInvoked">
            <ListView x:Name="RadiosListView"
                  CanReorderItems="False"
                  CanDragItems="False"
                  IsItemClickEnabled="True"
                  SelectionMode="None"
                  Style="{StaticResource RadioItemListStyle}"
                  SizeChanged="Grid_SizeChanged"
                  ItemContainerStyle="{StaticResource PlainCardItemStyle}"
                  ItemsSource="{Binding}"
                  ItemClick="RadiosListView_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="data:RadioItem">
                        <controls:SlidableListItem                         
                              DataContext="{Binding ElementName=Control, Path=DataContext, Mode=OneWay}"
                              HorizontalAlignment="Stretch"
                              ActivationWidth="64"                            
                              IsLeftCommandEnabled="True"
                              IsOffsetLimited="True"                             
                              IsPointerReleasedOnSwipingHandled="True"
                              IsRightCommandEnabled="False"
                              LeftBackground="SkyBlue"          
                              LeftForeground ="White"
                              LeftCommand="{StaticResource FavoriteItemCommand}"
                              LeftCommandParameter="{Binding DataContext, RelativeSource={RelativeSource TemplatedParent}}"
                              LeftIcon="Favorite"
                              LeftLabel="收藏"
                              MouseSlidingEnabled="False">
                            <Border Name="RadioCard"
                                    Background="{StaticResource CardNormalBackground}"
                                    BorderBrush="{StaticResource CardNormalBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,10"
                                    Margin="4"
                                    PointerEntered="RadioList_PointerEntered"
                                    PointerExited="RadioList_PointerExited">
                            <Grid Name="RadioList"
                                  Background="Transparent"
                                  Width="{Binding ElementName=width,Path=Width}">
                                <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <Image Width="64" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="{Binding ElementName=width, Path=Opacity}"
                                        Source="{Binding DataContext.ImageUri ,RelativeSource={RelativeSource TemplatedParent},TargetNullValue=ms-appx:///Assets/recommend_defaultbg.png, FallbackValue=ms-appx:///Assets/recommend_defaultbg.png}">
                                </Image>
                            </StackPanel>
                            <Grid Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{x:Bind Title}" Tag="{x:Bind Id}" FontSize="14" Grid.Row="0"/>
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBlock Text="正在直播：" FontSize="13" Foreground="#FF61A3AE" />
                                                <TextBlock Text="{x:Bind NowPlaying, TargetNullValue=暂无节目单}" FontSize="13"  Foreground="#FF61A3AE">
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                        <Button Name="Favorite"
                                                Grid.Column="1"
                                                Content="&#xE1CE;" 
                                                FontFamily="Segoe MDL2 Assets" 
                                                Background="Transparent"  
                                                Visibility="Collapsed"
                                                VerticalAlignment="Top"
                                                RelativePanel.AlignRightWithPanel="True"
                                                Click="Favorite_Click" 
                                                DataContext="{Binding DataContext, RelativeSource={RelativeSource TemplatedParent}}">
                                        </Button>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                    <RelativePanel Margin="0,6,0,0">
                                        <StackPanel RelativePanel.AlignLeftWithPanel="True" Orientation="Horizontal" MinWidth="192">
                                            <TextBlock Text="直播时间：" FontSize="12" Foreground="#FF94C5CD"/>
                                            <TextBlock Text="{x:Bind TimeInterval, TargetNullValue=00:00-00:00}" TextAlignment="Left" FontSize="12" Foreground="#FF94C5CD"/>
                                        </StackPanel>
                                        <RelativePanel RelativePanel.AlignRightWithPanel="True" MinWidth="84">
                                            <TextBlock Text="{x:Bind PlayCount, TargetNullValue=0000, Converter={StaticResource convertAudienceCount}}"  FontSize="12" Foreground="#FF94C5CD"/>
                                        </RelativePanel>
                                    </RelativePanel>
                                </Grid>
                            </Grid>
                        </Grid>
                            </Border>
                        </controls:SlidableListItem>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </pr:PullToRefreshBox>
    </Grid>
</UserControl>
