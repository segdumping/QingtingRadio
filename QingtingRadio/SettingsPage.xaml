<Page
    x:Class="QingtingRadio.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QingtingRadio"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="840"
    d:DesignWidth="400">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <local:PageHeader VerticalAlignment="Center">
            <local:PageHeader.HeaderContent>
                <TextBlock Name="TitleName" Text="设置" VerticalAlignment="Center" Margin="0,0,0,2" FontSize="16"/>
            </local:PageHeader.HeaderContent>
        </local:PageHeader>
        <ScrollViewer ScrollViewer.VerticalScrollBarVisibility="Hidden" Grid.Row="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="48"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="24"></RowDefinition>
                </Grid.RowDefinitions>
                <ListBox Name="ToggleList" Grid.Row="0" Background="Transparent" Tapped="ToggleList_Tapped" ScrollViewer.VerticalScrollMode="Disabled">
                    <ListBoxItem HorizontalContentAlignment="Stretch"  Height="42">
                        <RelativePanel Margin="0,-16">
                            <TextBlock Text="使用2G/3G/4G网络播放" 
                                    RelativePanel.AlignLeftWithPanel="True"
                                    RelativePanel.AlignVerticalCenterWithPanel="True">
                            </TextBlock>
                            <ToggleSwitch RelativePanel.AlignRightWithPanel="True"
                                    MinWidth="0"
                                    Name="MobileNetSwitch"
                                    Toggled="MobileNetSwitch_Toggled"                        
                                    IsOn="{Binding MoNet, Mode=TwoWay}"
                                    RelativePanel.AlignVerticalCenterWithPanel="True">
                            </ToggleSwitch>
                        </RelativePanel>
                    </ListBoxItem>
                    <ListBoxItem HorizontalContentAlignment="Stretch"  Height="42">
                        <RelativePanel Margin="0,-16">
                            <TextBlock Text="使用2G/3G/4G网络下载" 
                                       RelativePanel.AlignLeftWithPanel="True"
                                       RelativePanel.AlignVerticalCenterWithPanel="True">
                            </TextBlock>
                            <ToggleSwitch RelativePanel.AlignRightWithPanel="True"
                                      MinWidth="0"
                                      Name="MobileNetDownload"
                                      Toggled="MobileNetDownload_Toggled"
                                      IsOn="{Binding MoNetDownload, Mode=TwoWay}"
                                      RelativePanel.AlignVerticalCenterWithPanel="True">
                            </ToggleSwitch>
                        </RelativePanel>
                    </ListBoxItem>
                    <ListBoxItem HorizontalContentAlignment="Stretch"  Height="42">
                        <RelativePanel Margin="0,-16">
                            <TextBlock Text="使用高比特率播放下载" 
                                   RelativePanel.AlignLeftWithPanel="True"
                                   RelativePanel.AlignVerticalCenterWithPanel="True">
                            </TextBlock>
                            <ToggleSwitch RelativePanel.AlignRightWithPanel="True"
                                      MinWidth="0"
                                      Name="HighBitrate"
                                      OffContent="低"
                                      OnContent="高"
                                      IsOn="{Binding IsHighBitrate, Mode=TwoWay}"
                                      RelativePanel.AlignVerticalCenterWithPanel="True">
                            </ToggleSwitch>
                        </RelativePanel>
                    </ListBoxItem>
                    <ListBoxItem HorizontalContentAlignment="Stretch"  Height="42">
                        <RelativePanel Margin="0,-16">
                            <TextBlock Text="透明磁贴" 
                               RelativePanel.AlignLeftWithPanel="True"
                               RelativePanel.AlignVerticalCenterWithPanel="True">

                            </TextBlock>
                            <ToggleSwitch RelativePanel.AlignRightWithPanel="True"
                                  MinWidth="0"
                                  Name="TransparentTileSwitch"
                                  Toggled="TransparentTileSwitch_Toggled"
                                  IsOn="{Binding TransparentTile, Mode=TwoWay}"
                                  RelativePanel.AlignVerticalCenterWithPanel="True">
                            </ToggleSwitch>
                        </RelativePanel>
                    </ListBoxItem>
                    <ListBoxItem HorizontalContentAlignment="Stretch"  Height="42">
                        <RelativePanel Margin="0,-16">
                            <TextBlock Text="夜间模式" 
                                   RelativePanel.AlignLeftWithPanel="True"
                                   RelativePanel.AlignVerticalCenterWithPanel="True">
                            </TextBlock>
                            <ToggleSwitch RelativePanel.AlignRightWithPanel="True"
                                      MinWidth="0"
                                      Name="ThemeSwitch"
                                      IsOn="{Binding AppTheme, Mode=TwoWay}"
                                      RelativePanel.AlignVerticalCenterWithPanel="True">
                            </ToggleSwitch>
                        </RelativePanel>
                    </ListBoxItem>
                    <ListBoxItem HorizontalContentAlignment="Stretch"  MinHeight="42">
                        <Grid Margin="0,-16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <RelativePanel Grid.Row="0" >
                                <TextBlock Text="自动切换夜间模式" 
                                   RelativePanel.AlignLeftWithPanel="True"
                                   RelativePanel.AlignVerticalCenterWithPanel="True">

                                </TextBlock>
                                <ToggleSwitch RelativePanel.AlignRightWithPanel="True"
                                      MinWidth="0"  
                                      Name="AutoThemeSwitch"
                                      Toggled="AutoThemeSwitch_Toggled"
                                      IsOn="{Binding AutoSwitchTheme, Mode=TwoWay}"
                                      RelativePanel.AlignVerticalCenterWithPanel="True">
                                </ToggleSwitch>
                            </RelativePanel>
                            <StackPanel Grid.Row="1" Name="timePicker" Visibility="Collapsed">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" 
                                            Orientation="Vertical" 
                                            Margin="0,4">
                                        <TextBlock Text="开始时间：" 
                                               Margin="12,1,0,1" 
                                               Foreground="#FFBBC1D1" 
                                               VerticalAlignment="Center" 
                                               FontSize="14">
                                        </TextBlock>
                                        <TimePicker Name="StartTime"
                                                Margin="12,1,0,1" 
                                                TimeChanged="StartTime_TimeChanged">
                                        </TimePicker>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" 
                                            Orientation="Vertical" 
                                            Margin="0,4">
                                        <TextBlock Text="结束时间：" 
                                               Margin="12,1,0,1" 
                                               Foreground="#FFBBC1D1" 
                                               VerticalAlignment="Center" 
                                               FontSize="14">
                                        </TextBlock>
                                        <TimePicker Name="EndTime" 
                                                Margin="12,1,0,1" 
                                                TimeChanged="EndTime_TimeChanged">
                                        </TimePicker>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem HorizontalContentAlignment="Stretch"  MinHeight="42">
                        <Grid Margin="0,-16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <RelativePanel Grid.Row="0">
                                <TextBlock Text="定时关闭" 
                                   RelativePanel.AlignLeftWithPanel="True"
                                   RelativePanel.AlignVerticalCenterWithPanel="True">
                                </TextBlock>
                                <ToggleSwitch RelativePanel.AlignRightWithPanel="True"
                                      MinWidth="0"
                                      Name="TimerPause"
                                      Toggled="TimerPause_Toggled"
                                      IsOn="{Binding TimerPause, Mode=TwoWay}"
                                      RelativePanel.AlignVerticalCenterWithPanel="True">
                                </ToggleSwitch>
                            </RelativePanel>
                            <StackPanel Grid.Row="1" 
                                    Orientation="Vertical" 
                                    Margin="0,4" 
                                    Visibility="Collapsed" 
                                    Name="timerPausedTime">
                                <TextBlock Text="关闭时间：" 
                                       Margin="12,1,0,1" 
                                       Foreground="#FFBBC1D1" 
                                       VerticalAlignment="Center" 
                                       FontSize="14">
                                </TextBlock>
                                <TimePicker Name="timerPicker" 
                                        Margin="12,1,0,1" 
                                        TimeChanged="timerPicker_TimeChanged">
                                </TimePicker>
                            </StackPanel>
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem HorizontalContentAlignment="Stretch"  MinHeight="42">
                        <Grid Margin="0,-16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <RelativePanel Grid.Row="0">
                                <TextBlock Text="自定义所在省市" 
                                   RelativePanel.AlignLeftWithPanel="True"
                                   RelativePanel.AlignVerticalCenterWithPanel="True">
                                </TextBlock>
                                <ToggleSwitch RelativePanel.AlignRightWithPanel="True"
                                      MinWidth="0"
                                      Name="CustomRegion"
                                      Toggled="CustomRegion_Toggled"
                                      IsOn="{Binding HasCustomRegion, Mode=TwoWay}"
                                      RelativePanel.AlignVerticalCenterWithPanel="True">
                                </ToggleSwitch>
                            </RelativePanel>
                            <StackPanel Grid.Row="1" 
                                    Margin="0,4" 
                                    Visibility="Collapsed"
                                    Orientation="Horizontal"
                                    Name="customRegion">
                                <TextBlock Text="所在省市 : "
                                       Foreground="#FFBBC1D1" 
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0">
                                </TextBlock>
                                <ComboBox Name="Region" 
                                      Margin="4,0,0,0"                                      
                                      MaxDropDownHeight="240"                                      
                                      VerticalAlignment="Center" 
                                      HorizontalContentAlignment="Left"
                                      SelectionChanged="Region_SelectionChanged" 
                                      ScrollViewer.VerticalScrollBarVisibility="Hidden" >
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Title}"  
                                                   Tag="{Binding ID}"
                                                   HorizontalAlignment="Left">
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </ListBoxItem>
                </ListBox>
                <ListBox Name="SingleList" Grid.Row="3" Tapped="SingleList_Tapped"  Background="Transparent" ScrollViewer.VerticalScrollMode="Disabled">
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Name="ClearCache" Text="清除缓存 :"/>
                        <TextBlock Name="CacheSize" Text="{Binding CacheSize, Mode=TwoWay}" Margin="6,0,0,0"/>
                        <TextBlock Text="M"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Name ="Evaluation" Text="打分并评价"/>
                    </StackPanel>
                    <ListBoxItem  HorizontalContentAlignment="Stretch"  MinHeight="42">
                        <RelativePanel Margin="0,-16">
                            <TextBlock Name="FeedBack" Text="意见反馈" RelativePanel.AlignLeftWithPanel="True" ToolTipService.ToolTip="通过邮箱反馈"  RelativePanel.AlignVerticalCenterWithPanel="True"/>
                            <HyperlinkButton Content="QQ群：641796042" NavigateUri="https://jq.qq.com/?_wv=1027&amp;k=49Iw0uz" ToolTipService.ToolTip="蜻蜓电台问题反馈QQ群" Background="Transparent" RelativePanel.AlignRightWithPanel="True" Margin="0,0,4,0"/>
                        </RelativePanel>
                    </ListBoxItem>
                    <StackPanel>
                        <TextBlock Name="VersionLog" Text="更新日志"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Name="LogFile" Text="导出日志文件"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="当前版本 :  "/>
                        <TextBlock Name="Version" Text="{Binding CurrentVersion, Mode=OneWay}"/>
                    </StackPanel>
                </ListBox>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
