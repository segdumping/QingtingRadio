<UserControl
    x:Class="QingtingRadio.PlayerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QingtingRadio"
    xmlns:data="using:QingtingRadio.DataModels"
    xmlns:vm="using:QingtingRadio.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:ThumbProgressConverter x:Key="progressConverter"></local:ThumbProgressConverter>
        <Flyout x:Key="volumeFlyout">
            <local:VolumeControl x:Name="VolumeValue"></local:VolumeControl>
        </Flyout>
    </UserControl.Resources>
        
    <Grid Height="56" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource LargeWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LargePlayControl.Visibility" Value="Visible"/>
                        <Setter Target="SmallPlayControl.Visibility" Value="Collapsed"/>
                        <Setter Target="PlayRing.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MediumWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LargePlayControl.Visibility" Value="Visible"/>
                        <Setter Target="SmallPlayControl.Visibility" Value="Collapsed"/>
                        <Setter Target="PlayRing.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LargePlayControl.Visibility" Value="Collapsed"/>
                        <Setter Target="SmallPlayControl.Visibility" Value="Visible"/>
                        <Setter Target="PlayRing.Visibility" Value="Visible"/>
                        <Setter Target="PlayImage.IsTapEnabled" Value="True"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        
        <StackPanel Grid.Column="0"  
                    Width="64"                                        
                    Background="Transparent"
                    HorizontalAlignment="Stretch">
            <Image  x:Name="PlayImage"                   
                    Tapped="PlayImage_Tapped"
                    Source="{Binding ImageUri, Mode=OneWay}"  
                    Height="58" 
                    Width="64" 
                    HorizontalAlignment="Left">
            </Image>
        </StackPanel>
        <Grid Grid.Column="1" Name="SmallPlayControl">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel  Grid.Column="0"
                         Name="PlayTitle"
                         Tapped="PlayTitle_Tapped"
                         Background="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <RelativePanel Grid.Row="0" >
                        <TextBlock x:Name="nowplaying" 
                               Text="{Binding NowPlaying, Mode=OneWay}"  
                               TextWrapping="NoWrap"
                               Foreground="{ThemeResource SystemAccentColor}"
                               VerticalAlignment="Center" 
                               FontSize="14" 
                               Margin="4,8,0,0">
                        </TextBlock>
                    </RelativePanel>
                    <RelativePanel Grid.Row="1">
                        <TextBlock  Name="title" Text="{Binding Title, Mode=OneWay}"  
                                VerticalAlignment="Center" 
                                FontSize="12" 
                                Margin="4,6,0,0">
                        </TextBlock>
                    </RelativePanel>
                </Grid>
            </StackPanel>
            <Grid Grid.Column="1" HorizontalAlignment="Right">
                <Button x:Name="playButton"   
                    Height="36" 
                    Width="36" 
                    Margin="0,0,0,0" 
                    Click="playButton_Click" 
                    Background="Transparent" 
                    Style="{StaticResource CustomButtonStyle}"
                    Tag="{Binding PlayID , Mode=OneWay}">
                    <SymbolIcon x:Name="playbuttonicon"
                            Symbol="Play" 
                            Height="64" 
                            Width="64"
                            Margin="-24,-20">
                    </SymbolIcon>
                </Button>
                <ProgressRing Name="PlayRing"
                      IsActive="{Binding IsBuffering, Mode=TwoWay}" 
                      Grid.Column="1"
                      TabIndex="100"  
                      Foreground="Blue"
                      Height="36"
                      Width="36">
                </ProgressRing>
            </Grid>
        </Grid>
        <Grid Grid.Column="1" Name="LargePlayControl" Visibility="{Binding LargeVisibility, Mode=TwoWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <local:PlayControl Grid.Column="0" Width="136"></local:PlayControl>
            <Grid Grid.Column="1" Margin="16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <local:ProgressControl x:Name="Progress" Grid.Row="0"></local:ProgressControl>
                <RelativePanel Grid.Row="1">
                    <StackPanel Name="test" Margin="0,0,0,8" Orientation="Horizontal" RelativePanel.AlignLeftWithPanel="True"
                                Tapped="PlayTitle_Tapped" Background="Transparent">
                        <TextBlock Text="{Binding ElementName=title,Path=Text}" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"></TextBlock>
                        <TextBlock Text=":"/>
                        <TextBlock Text="{Binding ElementName=nowplaying,Path=Text}" FontSize="14" Margin="4,1,0,0" VerticalAlignment="Center" Foreground="{ThemeResource SystemAccentColor}"></TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" RelativePanel.AlignRightWithPanel="True">
                        <TextBlock  Name="currentPosition" Text="{Binding ElementName=Progress,Path=Position}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="/" FontSize="14" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center"/>
                        <TextBlock  Name="totalTime" Text="{Binding ElementName=Progress,Path=Duration}" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </RelativePanel>
            </Grid>
            <Grid Grid.Column="2">
                <Button Name="Volume"
                        Width="36" 
                        Height="36"  
                        Background="Transparent"
                        Content="&#xE767;" 
                        FontFamily="Segoe MDL2 Assets" 
                        FontSize="16" 
                        Margin="2,0"                       
                        Flyout="{StaticResource volumeFlyout}"
                        Style="{StaticResource CustomButtonStyle}">
                </Button>
            </Grid>
        </Grid>
        <StackPanel Grid.Column="2" 
                    Width="36"
                    VerticalAlignment="Center">
            <Button x:Name="MediaListControl"
                    Height="36"
                    Content="&#xE14C;" 
                    FontFamily="Segoe MDL2 Assets" 
                    FontSize="24"
                    Click="Replay_Click"
                    ToolTipService.ToolTip="回听列表"
                    Background="Transparent"
                    Style="{StaticResource CustomButtonStyle}"/>
        </StackPanel>
    </Grid>
</UserControl>
