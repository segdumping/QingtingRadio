<UserControl
    x:Class="QingtingRadio.CustomControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QingtingRadio"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <Grid MinHeight="64" 
          MinWidth="120"
          Margin="0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,3">
            <TextBox Name="Title"
                     Header="电台名称"
                     TextWrapping="NoWrap"
                     TextChanged="Title_TextChanged"
                     InputScope="ChineseHalfWidth">
            </TextBox>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,3">
            <TextBox Name="PlayUri"
                     Header="电台地址"                     
                     TextWrapping="NoWrap"
                     InputScope="Url">
            </TextBox>
        </StackPanel>
    </Grid>
</UserControl>
