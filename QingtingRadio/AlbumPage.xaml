<Page
    x:Class="QingtingRadio.AlbumPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QingtingRadio"
    xmlns:pr="using:PullToRefresh.UWP"
    xmlns:data="using:QingtingRadio.DataModels"
    xmlns:vm="using:QingtingRadio.ViewModels"
    xmlns:controls="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="Page"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <UserControl.Resources>
        <vm:ConvertPlayDuration x:Key="convertPlayDuration"></vm:ConvertPlayDuration>
        <vm:ConvertPlayCount x:Key="convertPlayCount"></vm:ConvertPlayCount>
        <vm:ConvertAlbumUpdateTime x:Key="convertAlbumUpdateTime"></vm:ConvertAlbumUpdateTime>
        <local:FavoriteAlbumItemCommand x:Key="favoriteAlbumItemCommand" />
        <local:DowanloadAlbumItemCommand x:Key="dowanloadAlbumItemCommand" />
    </UserControl.Resources>
    
    <Grid SizeChanged="Grid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <local:PageHeader VerticalAlignment="Center">
            <local:PageHeader.HeaderContent>
                <TextBlock Name="TitleName" VerticalAlignment="Center" Margin="0,0,0,2" FontSize="16"/>
            </local:PageHeader.HeaderContent>
        </local:PageHeader>
        <Grid Grid.Row="1" MaxHeight="108">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Name="AlbumThumb"
                   Height="96"
                   VerticalAlignment="Top"
                   Margin="18,8,8,8"
                   Grid.Column="0">
            </Image>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <controls:WrapPanel Grid.Row="0">
                    <TextBlock Name="PlayCount" FontSize="13" Margin="8,4,8,0"/>
                    <TextBlock Name="PragramCount" FontSize="13" Margin="8,4,8,0"/>
                    <TextBlock Name="UpdateTime" FontSize="13" Margin="8,4,8,0"/>
                </controls:WrapPanel>
                <Rectangle Grid.Row="1" Height="1" Margin="4,4,12,0" Opacity="0.7" Fill="{ThemeResource SystemControlForegroundBaseLowBrush}"/>
                <ScrollViewer Grid.Row="2"
                          Margin="8,0,8,8"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden">
                    <TextBlock Name="AlbumDescription"
                           FontSize="13"
                           TextWrapping="Wrap">
                    </TextBlock>
                </ScrollViewer>
            </Grid>
        </Grid>
        <Rectangle Grid.Row="2" Height="1" Margin="12,-14,12,0" Opacity="0.7" Fill="{ThemeResource SystemControlForegroundBaseLowBrush}"/>
        <Border x:Name="width" Visibility="Collapsed" Grid.Row="3"/>
        <pr:PullToRefreshBox Grid.Row="3" RefreshThreshold="48" RefreshInvoked="PullToRefreshBox_RefreshInvoked">
            <ListView Name="AlbumList"
                  CanDragItems="False"
                  Grid.Row="3"  
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  IsTapEnabled="False"
                  Style="{StaticResource RadioItemListStyle}"
                  ItemContainerStyle="{StaticResource CardItemStyle}"
                  ItemClick="AlbumList_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="data:AlbumItem">
                        <controls:SlidableListItem                         
                              DataContext="{Binding ElementName=Page, Path=DataContext, Mode=OneWay}"
                              HorizontalAlignment="Stretch"
                              ActivationWidth="64"                            
                              IsLeftCommandEnabled="True"
                              IsOffsetLimited="True"                             
                              IsPointerReleasedOnSwipingHandled="True"
                              LeftBackground="SkyBlue"          
                              LeftForeground ="White"
                              LeftCommand="{StaticResource favoriteAlbumItemCommand}"
                              LeftCommandParameter="{Binding DataContext, RelativeSource={RelativeSource TemplatedParent}}"
                              LeftIcon="Favorite"
                              LeftLabel="收藏"
                              IsRightCommandEnabled="True"
                              RightBackground="SpringGreen"
                              RightForeground="White"
                              RightIcon="Download"
                              RightLabel="下载"
                              RightCommand="{StaticResource dowanloadAlbumItemCommand}"
                              RightCommandParameter="{Binding DataContext, RelativeSource={RelativeSource TemplatedParent}}"
                              MouseSlidingEnabled="False">
                            <Grid  Margin="0"
                                   Background="Transparent"
                                   PointerEntered="Grid_PointerEntered"
                                   PointerExited="Grid_PointerExited"
                                   Width="{Binding ElementName=width,Path=Width}">
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Name="Title"
                                                Text="{Binding DataContext.Title,RelativeSource={RelativeSource TemplatedParent}}" FontSize="13" TextWrapping="NoWrap" TextTrimming="WordEllipsis" MaxLines="1" Margin="0,4"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                                            <Button Content="&#xE1CE;" FontFamily="Segoe MDL2 Assets" Background="Transparent"  Click="FavoriteAlbumItem_Click" DataContext="{Binding DataContext, RelativeSource={RelativeSource TemplatedParent}}"/>
                                            <Button Content="&#xE118;" FontFamily="Segoe MDL2 Assets" Background="Transparent" Click="DownloadRadioItem_Click" DataContext="{Binding DataContext, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,4">
                                        <RelativePanel>
                                            <StackPanel RelativePanel.AlignLeftWithPanel="True" Orientation="Horizontal">
                                                <TextBlock Text="播放：" Foreground="#FF94C5CD" FontSize="12"/>
                                            <TextBlock Name="PlayCount" Text="{Binding DataContext.PlayCount,RelativeSource={RelativeSource TemplatedParent}}" Foreground="#FF94C5CD" FontSize="12" TextAlignment="Left" />
                                            </StackPanel>
                                        <TextBlock Name="Duration" Text="{Binding DataContext.Duration,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource convertPlayDuration}}" RelativePanel.AlignHorizontalCenterWithPanel="True"  Margin="0,0,0,0" Foreground="#FF94C5CD" FontSize="12" TextAlignment="Left" />
                                        <TextBlock Name="UpdateTime" Text="{Binding DataContext.UpdateTime,RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource convertAlbumUpdateTime}}" RelativePanel.AlignRightWithPanel="True" Margin="0,0,8,0" Foreground="#FF94C5CD"  FontSize="12" TextAlignment="Left" />
                                        </RelativePanel>
                                    </Grid>
                                </Grid>
                            </controls:SlidableListItem>
                        </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </pr:PullToRefreshBox>
        <ProgressRing Name="RingCircle" Grid.RowSpan="4" TabIndex="100" Height="48" Width="48"
                      Foreground="{ThemeResource SystemAccentColor}">
        </ProgressRing>
    </Grid>
</Page>
